/collection\/happy-flyaway-days-19940283"},{"id":"1538356","collection":"","credit":"Gift of Richard Parker","culture":"","dating":"","datingYearFrom":"1930","datingYearTo":"1969","description":"\u003Cp\u003EHappy Flower Gathering Days\u003C\/p\u003E\n","dimensions":"31.1 x 46 cm (12 1\/4 x 18 1\/8 inches) (plate)","edition":"","inscription":"Original--Inside cover on right:in LR in pencil:1994.028.2; in LR typeset:This desk folder was designed for Vanity Fair by\/Andy Warhol, the celebrated young artist whose\/paintings hang in more and more galleries, con-\/temporary museums and private collections.(For a\/colorful pair of pictures for your own wall, wt the\/folder in two and frame each half.)\/HAPPY FLOWER-GATHERING DAYSIn Plate--Front cover in UL corner:Happy Flower gathering daysBack Cover:In LL:Warhol","makers":[{"name":"Andy Warhol","risdAffiliation":null,"years":"1928-1987, b. in Pittsburgh, Pennsylvania","nationality":["American"],"nationalityModifiers":null,"role":null,"attribution_type":null}],"medium":["color offset"],"mediumTechnique":"color offset","objectNumber":"1994.028.2","onView":false,"place":"","primaryMaker":"Andy Warhol","publicDomain":false,"recentAcquisition":false,"referenceNumber":"","relatedObjects":[],"state":"","support":["Medium weight cream wove board (manila folder)"],"technique":["color offset"],"title":"Happy Flower Gathering Days","type":["Prints"],"url":"https:\/\/risdmuseum.org\/art-design\/collection\/happy-flower-gathering-days-19940282"},{"id":"1555906","collection":"","credit":"Gift of Mrs. Gustav Radeke","culture":"Japanese","dating":"","datingYearFrom":"1500","datingYearTo":"1639","description":"\u003Cp\u003ELandscape\u003C\/p\u003E\n","dimensions":"Overall with mount: 246.4 x 82.9 cm (97 x 32 5\/8 inches)","edition":"","inscription":"","makers":[{"name":"T\u014dyo Sessh\u016b \u96ea\u821f\u7b49\u694a","risdAffiliation":null,"years":"1420-1506, b. in Bitch\u016b, Japan","nationality":[],"nationalityModifiers":null,"role":null,"attribution_type":null}],"medium":["Hanging scroll","ink on silk"],"mediumTechnique":"ink","objectNumber":"18.092","onView":false,"place":"Origin: Japan","primaryMaker":"T\u014dyo Sessh\u016b \u96ea\u821f\u7b49\u694a","publicDomain":false,"recentAcquisition":false,"referenceNumber":"","relatedObjects":["https:\/\/risdmuseum.org\/api\/v1\/collection?id=1427361"],"state":"","support":["silk"],"technique":["Hanging scroll","ink on silk"],"title":"Landscape","type":["Paintings"],"url":"https:\/\/risdmuseum.org\/art-design\/collection\/landscape-18092"},{"id":"1640491","collection":"","credit":"Gift of The Sharpe Family","culture":"","dating":"","datingYearFrom":"","datingYearTo":"","description":"\u003Cp\u003EGrapes in a Raised Glass Dish\u003C\/p\u003E\n","dimensions":"Framed: 38.1 x 32.4 cm (15 x 12 3\/4 inches)","edition":"","inscription":"Label: inscribed in graphite on label on verso, UL: \u0022#R41-2A [underlined] \/ 24 [encircled] 124\nLabel: Printed in black ink on label, verso, UC: \u0022Carl\u0027s \/ 22 Williams Street \/ Providence 3, R.I. \/ No. [illegible inscription in graphite]\u0022\nPrinted in black ink on typed note taped to back of frame: \u0022On August 10, 1995 this painting was received from the Metropolitan Museum of Art, sent by the Registrar\u0027s Office according to Rhiana Mcdonnell (Registered Mail #R 809 665 718). \/ When I telephoned her to inquire about it she informed me that it had been \u0022sitting around the office for four or five years\u0022, labelled \u0022Unsolicited Art\u0022. \/ Evidently the paperwork on it had been lost and no one knew anything about it. \/ It was returned to Mrs. Henry Sharpe at 84 Prospect Street, Providence, R.I., 02903 on August 1, 1995 after someone finally discovered the label on the back. (No prior attempt had been made to determine whether or not Mrs. Sharpe still lived at this address.) How lucky it was that it was then [underlined] forwarded to the Sharpes by someone who just happened to know we were in Sorrento! \/ We have thus decided to \u0022readopt\u0022 it and hang it along with the other Koehlers that have already been here (and enjoyed every minute) since the house was opened in 1988. \/ Florence Koehler, lying in her grave at the Poets Cemetery in Rome, not far from the Pyramid of Cestius, must surely be chuckling. \/ Hopefully she\u0027s happy, rejected by the Met. \/ But welcomed warmly [underlined] home by those old Koehler watcher friends of hers, the Sharpes!\u0022\nStamp: in brown ink, recto of frame, LL: Estate \/ of \/ Florence Koehler \/ 1861 - 1944 \/ M.E.S.","makers":[{"name":"Florence Cary Koehler","risdAffiliation":null,"years":"1861\u20131944, b. in Jackson, Michigan","nationality":["American"],"nationalityModifiers":null,"role":null,"attribution_type":null}],"medium":["Oil on paper"],"mediumTechnique":"","objectNumber":"2024.41.7","onView":false,"place":"","primaryMaker":"Florence Cary Koehler","publicDomain":false,"recentAcquisition":true,"referenceNumber":"","relatedObjects":[],"state":"","support":[],"technique":["Oil on paper"],"title":"Grapes in a Raised Glass Dish","type":["Drawings and Watercolors"],"url":"https:\/\/risdmuseum.org\/art-design\/collection\/grapes-raised-glass-dish-2024417"},{"id":"1190676","collection":"","credit":"Gift of Mr. and Mrs Scott Eaton","culture":"","dating":"","datingYearFrom":"1800","datingYearTo":"1899","description":"\u003Cp\u003EHanging Grapes\u003C\/p\u003E\n","dimensions":"51.1 x 41 cm (20 1\/8 x 16 1\/8 inches)","edition":"","inscription":"Signature: Signed LR:F. S. Batcheller","makers":[{"name":"Frederick S. Batcheller","risdAffiliation":null,"years":"1837-1889","nationality":["American"],"nationalityModifiers":null,"role":null,"attribution_type":null}],"medium":["oil paint"],"mediumTechnique":"oil paint","objectNumber":"81.288","onView":false,"place":"","primaryMaker":"Frederick S. Batcheller","publicDomain":false,"recentAcquisition":false,"referenceNumber":"","relatedObjects":[],"state":